{
  "name": "atelie-jessica-sistema",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply atelie-jessica-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply atelie-jessica-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261029.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.156.0"
  }
}
